# URL RFB
RFB_BASE_URL=https://arquivos.receitafederal.gov.br/public.php/webdav/
RFB_TOKEN=YggdBLfdninEJX9


# Database engine: "postgresql" ou "duckdb"
DB_ENGINE=postgresql

# --- PostgreSQL (obrigatório quando DB_ENGINE=postgresql) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=Dados_RFB

# --- DuckDB (usado quando DB_ENGINE=duckdb) ---
# Nome do arquivo DuckDB (criado dentro de data/)
DUCKDB_PATH=cnpj_rfb.duckdb

# File configuration
FILE_ENCODING=latin1
CHUNK_SIZE=200_000

# Logging configuration
LOG_LEVEL=INFO
